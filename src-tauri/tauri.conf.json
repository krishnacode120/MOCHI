{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mochi",
  "version": "0.6.3",
  "identifier": "com.mochi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run licenses",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Mochi",
        "url": "index.html?view=pet",
        "width": 320,
        "height": 340,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Mochi — A little company",
        "url": "index.html?view=settings",
        "width": 960,
        "height": 780,
        "minWidth": 720,
        "minHeight": 600,
        "visible": false,
        "center": true
      },
      {
        "label": "menu",
        "title": "Mochi menu",
        "url": "index.html?view=menu",
        "width": 260,
        "height": 540,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "reminder",
        "title": "A little care from Mochi",
        "url": "index.html?view=reminder",
        "width": 280,
        "height": 190,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "A cozy offline desktop companion",
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
